# ── HTML Forge — environment config ──────────────────────────────────────────

# Text model — downloaded automatically on first boot.
# Good choices: qwen2.5:7b  llama3.2:3b  mistral:7b  deepseek-r1:8b  codellama:13b
DEFAULT_MODEL=qwen2.5:7b

# Vision model — downloaded automatically if set (leave blank to skip).
# Good choices: llama3.2-vision:11b  llava:13b  gemma3:12b  minicpm-v:8b
VISION_MODEL=llama3.2-vision:11b

# Port for the web UI (default: http://localhost:8080)
UI_PORT=8080
